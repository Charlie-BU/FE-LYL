@charset "UTF-8";
/* 颜色变量 */
/* 公共样式 */
.app.data-v-d4e6bb4e {
  background: linear-gradient(0deg, #efefef 0%, #f6f6f6 25%, #1abfc0 100%);
}
.post-button.data-v-d4e6bb4e {
  margin-left: 30rpx;
  width: 100rpx;
