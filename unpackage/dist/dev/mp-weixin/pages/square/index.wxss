  font-family: PingFang SC, PingFang SC;
  font-size: 26rpx;
  color: black;
  text-align: left;
  font-style: normal;
  text-transform: none;
}
.section.data-v-d4e6bb4e {
  background: #ffffff;
  border-radius: 20rpx 20rpx 20rpx 20rpx;
  box-sizing: border-box;
  padding: 20rpx;
  margin: 20rpx 20rpx;
}
.section .boxList.data-v-d4e6bb4e {
  margin-top: 6rpx;
  box-sizing: border-box;
  padding: 30rpx 20rpx;
  padding-top: 40rpx;
  border-bottom: 1px solid #f2f2f2;
}
.section .boxList .left.data-v-d4e6bb4e {
  width: 20%;
}
.section .boxList .right.data-v-d4e6bb4e {
  margin-left: 20rpx;
  width: 90%;
}
.section .boxList .right .text1.data-v-d4e6bb4e {
  font-size: 32rpx;
  color: #333333;
  line-height: 35rpx;
}
.section .boxList .right .text3.data-v-d4e6bb4e {
  font-weight: 500;
  font-size: 26rpx;
  color: #999999;
  line-height: 38rpx;
  text-align: justify;
}
.section .boxList .lIcon.data-v-d4e6bb4e {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.section .boxList .bottom-icon.data-v-d4e6bb4e {
  width: 35rpx;
  height: 35rpx;
}
.section .boxList .image-grid.data-v-d4e6bb4e {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.section .boxList .image-item.data-v-d4e6bb4e {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
}
.section .boxList .post-images.data-v-d4e6bb4e {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 5rpx;
}
/* 背景遮罩 */
.modal-overlay.data-v-d4e6bb4e {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
/* 弹框容器 */
.modal.data-v-d4e6bb4e {
  width: 80%;
  background: #ffffff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  -webkit-animation: scaleIn-data-v-d4e6bb4e 0.3s ease;
          animation: scaleIn-data-v-d4e6bb4e 0.3s ease;
}
/* 动画效果 */
@-webkit-keyframes scaleIn-data-v-d4e6bb4e {
from {
    -webkit-transform: scale(0.9);
            transform: scale(0.9);
    opacity: 0;
}
to {
    -webkit-transform: scale(1);
            transform: scale(1);
    opacity: 1;
}
}
@keyframes scaleIn-data-v-d4e6bb4e {
from {
    -webkit-transform: scale(0.9);
            transform: scale(0.9);
    opacity: 0;
}
to {
    -webkit-transform: scale(1);
            transform: scale(1);
    opacity: 1;
}
}
