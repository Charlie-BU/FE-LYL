<view class="container data-v-3000c024"><view class="service-detail data-v-3000c024"><view class="service-name data-v-3000c024">{{serviceData.name}}</view><view class="service-price data-v-3000c024"><text class="price-symbol data-v-3000c024">¥</text><text class="price-value data-v-3000c024">{{serviceData.price}}</text></view><view class="service-desc data-v-3000c024">{{serviceData.description}}</view><view class="service-features data-v-3000c024"><block wx:for="{{serviceData.features}}" wx:for-item="feature" wx:for-index="index" wx:key="index"><view class="feature-item data-v-3000c024"><u-icon vue-id="{{'5fd0753c-1-'+index}}" name="checkmark-circle" color="#02ABAB" size="28" class="data-v-3000c024" bind:__l="__l"></u-icon><text class="data-v-3000c024">{{feature}}</text></view></block></view><button data-event-opts="{{[['tap',[['showBuyModal',['$event']]]]]}}" class="buy-btn data-v-3000c024" bindtap="__e">立即购买</button></view><u-popup vue-id="5fd0753c-2" show="{{showModal}}" mode="center" round="{{10}}" data-event-opts="{{[['^close',[['closeModal']]]]}}" bind:close="__e" class="data-v-3000c024" bind:__l="__l" vue-slots="{{['default']}}"><view class="modal-content data-v-3000c024"><view class="modal-header data-v-3000c024"><text class="modal-title data-v-3000c024">选择购买数量</text><text data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-close data-v-3000c024" bindtap="__e">×</text></view><view class="modal-body data-v-3000c024"><view class="quantity-selector data-v-3000c024"><text data-event-opts="{{[['tap',[['decreaseQuantity',['$event']]]]]}}" class="minus data-v-3000c024" bindtap="__e">-</text><input class="quantity-input data-v-3000c024" type="number" data-event-opts="{{[['input',[['__set_model',['','quantity','$event',[]]]]]]}}" value="{{quantity}}" bindinput="__e"/><text data-event-opts="{{[['tap',[['increaseQuantity',['$event']]]]]}}" class="plus data-v-3000c024" bindtap="__e">+</text></view><view class="total-price data-v-3000c024"><text class="data-v-3000c024">总价：</text><text class="price-symbol data-v-3000c024">¥</text><text class="price-value data-v-3000c024">{{totalPrice}}</text></view></view><view class="modal-footer data-v-3000c024"><button data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="cancel-btn data-v-3000c024" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['confirmPurchase',['$event']]]]]}}" class="confirm-btn data-v-3000c024" bindtap="__e">确认购买</button></view></view></u-popup></view>