<view class="container data-v-3000c024"><view class="service-detail data-v-3000c024"><view class="service-name data-v-3000c024">{{serviceData.name}}</view><block wx:if="{{$root.g0}}"><view class="service-images data-v-3000c024"><swiper class="swiper data-v-3000c024" circular="{{true}}" autoplay="{{true}}" interval="3000" duration="500" data-event-opts="{{[['change',[['swiperChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{serviceData.images}}" wx:for-item="image" wx:for-index="index" wx:key="index"><swiper-item class="swiper-item data-v-3000c024"><image src="{{image}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewImage',[index]]]]]}}" bindtap="__e" class="data-v-3000c024"></image></swiper-item></block></swiper><view class="swiper-dots data-v-3000c024"><block wx:for="{{serviceData.images}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['data-v-3000c024','dot',currentSwiperIndex===index?'active':'']}}"></view></block></view></view></block><view class="service-price data-v-3000c024"><text class="price-symbol data-v-3000c024">¥</text><text class="price-value data-v-3000c024">{{serviceData.price}}</text></view><image style="width:100%;height:54px;" src="/static/service/service-gurantee.png" mode="aspectFill" class="data-v-3000c024"></image><view class="service-desc data-v-3000c024">{{"安心购："+serviceData.description}}</view><view class="tab-container data-v-3000c024"><view class="tab-header data-v-3000c024"><view data-event-opts="{{[['tap',[['switchTab',['intro']]]]]}}" class="{{['data-v-3000c024','tab-item',activeTab==='intro'?'active':'']}}" bindtap="__e"><text class="data-v-3000c024">服务详情</text></view><view data-event-opts="{{[['tap',[['switchTab',['rule']]]]]}}" class="{{['data-v-3000c024','tab-item',activeTab==='rule'?'active':'']}}" bindtap="__e"><text class="data-v-3000c024">下单须知</text></view></view><view class="tab-content data-v-3000c024"><block wx:if="{{activeTab==='intro'&&serviceData.intro_img}}"><view class="service-intro-img data-v-3000c024"><image src="{{serviceData.intro_img}}" mode="widthFix" class="data-v-3000c024"></image></view></block><block wx:if="{{activeTab==='rule'&&serviceData.rule_img}}"><view class="service-rule-img data-v-3000c024"><image src="{{serviceData.rule_img}}" mode="widthFix" class="data-v-3000c024"></image></view></block></view></view><block wx:if="{{identity===2}}"><button data-event-opts="{{[['tap',[['showBuyModal',['$event']]]]]}}" class="buy-btn data-v-3000c024" bindtap="__e">立即购买</button></block></view><u-popup vue-id="5fd0753c-1" show="{{showModal}}" mode="center" round="{{10}}" data-event-opts="{{[['^close',[['closeModal']]]]}}" bind:close="__e" class="data-v-3000c024" bind:__l="__l" vue-slots="{{['default']}}"><view class="modal-content data-v-3000c024"><view class="modal-header data-v-3000c024"><text class="modal-title data-v-3000c024">选择购买数量</text><text data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-close data-v-3000c024" bindtap="__e">×</text></view><view class="modal-body data-v-3000c024"><view class="quantity-selector data-v-3000c024"><text data-event-opts="{{[['tap',[['decreaseQuantity',['$event']]]]]}}" class="minus data-v-3000c024" bindtap="__e">-</text><input class="quantity-input data-v-3000c024" type="number" data-event-opts="{{[['input',[['__set_model',['','quantity','$event',[]]]]]]}}" value="{{quantity}}" bindinput="__e"/><text data-event-opts="{{[['tap',[['increaseQuantity',['$event']]]]]}}" class="plus data-v-3000c024" bindtap="__e">+</text></view><view class="total-price data-v-3000c024"><text class="data-v-3000c024">总价：</text><text class="price-symbol data-v-3000c024">¥</text><text class="price-value data-v-3000c024">{{totalPrice}}</text></view></view><view class="modal-footer data-v-3000c024"><button data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="cancel-btn data-v-3000c024" bindtap="__e">取消</button><button data-event-opts="{{[['tap',[['confirmPurchase',['$event']]]]]}}" class="confirm-btn data-v-3000c024" bindtap="__e">确认购买</button></view></view></u-popup></view>