<view class="items-container data-v-c75141f6"><block wx:for="{{datas}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="zp-item data-v-c75141f6"><view class="zp-item-title data-v-c75141f6"><view class="left data-v-c75141f6"><text class="data-v-c75141f6">{{"发票抬头："+item.name}}</text></view><block wx:if="{{item.status=='审核通过'}}"><view class="right data-v-c75141f6"><image class="left-icon data-v-c75141f6" src="/static/my/qiyong.png" mode="widthFix"></image><text class="success-text data-v-c75141f6">审核通过</text></view></block><block wx:if="{{item.status=='待审核'}}"><view class="right data-v-c75141f6"><image class="left-icon data-v-c75141f6" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/check-wait.png" mode="widthFix"></image><text class="blue-text data-v-c75141f6">待审核</text></view></block><block wx:if="{{item.status=='审核失败'}}"><view class="right data-v-c75141f6"><image class="left-icon data-v-c75141f6" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/bohui.png" mode="widthFix"></image><text class="red-text data-v-c75141f6">审核失败</text></view></block></view><view class="zp-item-title data-v-c75141f6"><view class="left data-v-c75141f6"><text class="data-v-c75141f6">{{"纳税人识别号："+item.number}}</text></view><block wx:if="{{item.status=='审核通过'}}"><block class="data-v-c75141f6"><block wx:if="{{item.kp_status=='待开票'}}"><view class="right data-v-c75141f6"><image class="left-icon data-v-c75141f6" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/check-wait.png" mode="widthFix"></image><text class="blue-text data-v-c75141f6">待开票</text></view></block><block wx:if="{{item.kp_status=='已开票'}}"><view class="right data-v-c75141f6"><image class="left-icon data-v-c75141f6" src="/static/my/qiyong.png" mode="widthFix"></image><text class="success-text data-v-c75141f6">已开票</text></view></block></block></block></view><view class="zp-item-title data-v-c75141f6"><view class="left data-v-c75141f6"><text class="data-v-c75141f6">{{"邮箱："+item.email}}</text></view><view class="right data-v-c75141f6">{{item.money}}</view></view><view class="zp-item-title data-v-c75141f6"><view class="left data-v-c75141f6"><text class="data-v-c75141f6">{{"开票金额："+item.price}}</text></view><view class="center data-v-c75141f6"></view></view><block wx:if="{{item.status!='审核通过'&&item.status!='待审核'}}"><view class="zp-item-title data-v-c75141f6"><view class="left data-v-c75141f6"><text class="data-v-c75141f6">{{"失败原因："+item.reason}}</text></view><view class="center data-v-c75141f6"></view></view></block></view></block></view>