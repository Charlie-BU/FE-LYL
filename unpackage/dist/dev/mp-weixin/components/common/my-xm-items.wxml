<view class="items-container data-v-c74f2480"><block wx:for="{{datas}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['itemClick',[6,'$0',index],[[['datas','',index]]]]]]]}}" class="zp-item data-v-c74f2480" bindtap="__e"><view class="zp-item-title data-v-c74f2480"><view class="left data-v-c74f2480"><text class="data-v-c74f2480">{{item.title}}</text></view><view class="center data-v-c74f2480"></view><view class="right data-v-c74f2480">{{item.salary+item.salary_unit}}</view></view><view class="zp-item-tab data-v-c74f2480"><block wx:for="{{item.arr}}" wx:for-item="item2" wx:for-index="index2" wx:key="index2"><view class="tab-item data-v-c74f2480">{{item2}}</view></block></view><block wx:if="{{item.status==-1}}"><view class="zp-item-status data-v-c74f2480"><image class="icon data-v-c74f2480" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/check-wait.png" mode="widthFix"></image><text class="blue-text data-v-c74f2480">审核中</text></view></block><block wx:if="{{item.status==2}}"><view class="zp-item-status data-v-c74f2480"><image class="icon data-v-c74f2480" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/jg-red.png" mode="widthFix"></image><text class="red-text data-v-c74f2480">{{"已驳回："+item.reason}}</text></view></block><block wx:if="{{item.status==3}}"><view class="zp-item-status data-v-c74f2480"><image class="icon data-v-c74f2480" src="/static/my/qiyong.png" mode="widthFix"></image><text class="success-text data-v-c74f2480">启用中</text></view></block><block wx:if="{{item.status==4}}"><view class="zp-item-status data-v-c74f2480"><image class="icon data-v-c74f2480" src="https://liyilian.oss-cn-hangzhou.aliyuncs.com/static/index/yitingyong.png" mode="widthFix"></image><text class="yellow-text data-v-c74f2480">已停用</text></view></block><view class="zp-item-bot data-v-c74f2480"><button class="theme-btn data-v-c74f2480" size="mini" data-event-opts="{{[['tap',[['itemClick',[1,'$0',index],[[['datas','',ind