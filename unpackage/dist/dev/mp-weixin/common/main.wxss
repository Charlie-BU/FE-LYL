}
page {
  background: #efefef;
  height: 100%;
  font-size: 28rpx;
  color: #171717;
}
image {
  will-change: transform;
  width: auto;
  height: auto;
}
button {
  margin: 0;
  padding: 0;
}
button::before, button::after {
  content: none;
}
button[disabled] {
  background: #919191 !important;
}
