  color: #fff;
}
.submit {
  padding: 40rpx 0 0 0;
}
.submit-btn {
  width: 100%;
  color: #fff !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #00A73C !important;
  border-radius: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
}
.submit-btn[disabled] {
  background: rgba(0, 167, 60, 0.6) !important;
}
/*每个页面公共css */
.alert-popup {
  background: #fff;
  border-radius: 16rpx;
}
.alert-popup .alert-title {
  height: 80rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
}
.alert-popup .alert-info {
  padding: 40rpx 20rpx 60rpx 20rpx;
  text-align: center;
  font-size: 30rpx;
}
.alert-popup .alert-bot {
  height: 100rpx;
  display: flex;
  flex-direction: row;
  border-top: 0.5px solid #EFEFEF;
}
.alert-popup .alert-bot text {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  box-sizing: border-box;
}
.alert-popup .alert-bot text:first-child {
  border-right: 0.5px solid #EFEFEF;
}
.alert-popup .alert-bot text:last-child {
  color: #FE4927;
}
.group {
  padding: 0 20rpx;
}
.group .group-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 106rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.group .group-row:not(:last-child) {
  border-bottom: 0.5px solid #EFEFEF;
}
.group .group-row .title .group-row-left-img {
  width: 90rpx;
  height: 90rpx;
}
.group .group-row .group-row-right {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.group .group-row .group-row-right .group-row-right-img {
  width: 90rpx;
  height: 90rpx;
}
.group .group-row .group-row-right .group-row-right-more {
  width: 20rpx;
  margin-left: 10rpx;
}
.group .group-row .group-row-right .arrow-right {
  margin-left: 10rpx;
}
.group .group-row .group-row-right .group-row-right-text {
  color: #595959;
}
.group .group-row .group-row-right .theme {
  color: #ED4731;
}
.group .group-row .group-row-right .grey {
  color: #888888;
}
.weixin-login {
  position: relative;
}
.weixin-login .weixin-login-info {
  margin-left: 10%;
  width: 80%;
  border-radius: 20rpx;
  height: 600rpx;
  background: url(data:image/png;base64,) center/100% 100% no-repeat;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}
.weixin-login .weixin-login-info .text {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.weixin-login .weixin-login-info .weixin-login-btn {
  width: 80%;
  height: 86rpx;
  line-height: 86rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: #02AAAB;
}
.weixin-login .weixin-login-info .weixin-login-btn[disabled] {
  background: rgba(2, 170, 171, 0.5) !important;
}
.weixin-login .weixin-login-bot {
  text-align: center;
  margin-top: 40rpx;
}
.weixin-login .weixin-login-bot image {
  width: 57rpx;
}
.share-container {
  display: flex;
  flex-direction: row;
}
.share-container .item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
}
.share-container .item .fx-img {
  width: 100rpx;
}
.share-container .item .title {
  font-weight: 500;
  font-size: 28rpx;
  margin-top: 10rpx;
}
.paypwd-container {
  position: relative;
}
.paypwd-container .close-img {
  width: 36rpx;
  position: absolute;
  right: 20rpx;
  top: 20rpx;
}
.paypwd-container .title {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  font-weight: 500;
  font-size: 28rpx;
}
.paypwd-container .form-rows {
  padding: 0 30rpx;
}
.paypwd-container .form-rows .row-input {
  min-height: 100rpx;
  border-bottom: 0.5px solid #EFEFEF;
}
.paypwd-container .btn-container {
  padding: 30rpx 30rpx 30rpx 30rpx;
}
.paypwd-container .btn-container .con-btn {
  background: #02ABAB;
  margin: 0 auto;
  border-radius: 40rpx;
  color: #fff;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-weight: 500;
  border-radius: 50rpx;
}
.paypwd-container .btn-container .con-btn[disabled] {
  background: rgba(2, 171, 171, 0.5);
  color: #fff;
}
.take-photo {
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
}
.take-photo .top .take-photo-item {
  border-bottom: 0.5px solid #EFEFEF;
}
.take-photo .take-photo-item {
  height: 100rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.take-photo .cancel-text {
  color: #ABABAB;
}
.take-photo-two {
  padding: 0 18rpx 28rpx 18rpx;
}
.take-photo-two .top-images {
  border-radius: 36rpx;
  background: #fff;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  padding-bottom: 35rpx;
}
.take-photo-two .top-images .top-title {
  display: flex;
  flex-direction: row;
}
.take-photo-two .top-images .top-title text {
  line-height: 100rpx;
}
.take-photo-two .top-images .top-title .cancel-text {
  color: #B8B8B8;
}
.take-photo-two .top-images .top-title .center-text {
  font-size: 30rpx;
  font-weight: bold;
  flex: 1;
  text-align: center;
}
.take-photo-two .top-images .top-title .confirm-text {
  color: #02AAAB;
}
.take-photo-two .top-images .images {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-gap: 30rpx 0;
  margin-top: 10rpx;
}
.take-photo-two .top-images .images .img-item {
  text-align: center;
}
.take-photo-two .top-images .images .img-item .img-con {
  position: relative;
  display: inline-block;
}
.take-photo-two .top-images .images .img-item .img-con .info-img {
  width: 90rpx;
  border-radius: 10rpx;
}
.take-photo-two .top-images .images .img-item .img-con .sel-img {
  width: 30rpx;
  position: absolute;
  right: 0;
  top: 0;
}
.take-photo-two .bot {
  background: #fff;
  border-radius: 36rpx;
}
.take-photo-two .bot .take-photo-item {
  height: 92rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.take-photo-two .bot .take-photo-item:not(:last-child) {
  border-bottom: 0.5px solid #EFEFEF;
}
.take-photo-two .bot .cancel-text {
  color: #ABABAB;
}
.top-border {
  height: 20rpx;
  background: #efefef;
}
